# BitAgent — example environment configuration
# Copy to .env and fill in your values.

# ── Payments ─────────────────────────────────────────────────────────────────

# LNbits instance URL and invoice/admin API key.
LNBITS_URL=https://your-lnbits-instance.com
LNBITS_API_KEY=your_lnbits_api_key_here

# Set to false to run a node with no wallet. Every service becomes free and is
# labeled as such in /health, /services and each agent's /info.
#
# A node with no LNbits credentials and PAYMENTS_ENABLED unset REFUSES TO START.
# That is deliberate: the alternative is a deployment that looks healthy while
# giving every paid service away.
# PAYMENTS_ENABLED=true

# How long an unpaid invoice quote stays redeemable.
# INVOICE_TTL_SECONDS=3600

# ── Storage ──────────────────────────────────────────────────────────────────

# Where the payment ledger and identity database live.
#
# MOUNT THIS AS A VOLUME IN PRODUCTION. The ledger is what makes each payment
# single-use; if it is lost, every previously settled payment hash becomes
# replayable. The Docker image defaults this to /data.
# BITAGENT_DATA_DIR=./data

# ── Operations ───────────────────────────────────────────────────────────────

# Enables GET /wallet/balance and GET /wallet/ledger, both requiring an
# X-Admin-Key header. While this is unset those routes are not registered at
# all, so a missing key cannot leave them exposed. Minimum 16 characters.
# ADMIN_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────

PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins. Using "*" disables credentialed
# requests, since browsers reject that combination anyway.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com

# Per-IP rate limiting. In-process, so with multiple workers the effective limit
# is (limit x workers).
# RATE_LIMIT=true

# Maximum request body in bytes. File upload routes enforce their own limits.
# MAX_BODY_BYTES=1048576

# Public base URL used in Nostr agent announcements (auto-detected on Railway).
# PUBLIC_URL=https://your-domain.com

# ── Search backends ──────────────────────────────────────────────────────────

# SearchAgent tries Brave, then SearXNG, then DuckDuckGo. DuckDuckGo needs no
# configuration, so these are optional but give better results.
# BRAVE_API_KEY=
# SEARXNG_URL=https://searxng.example.com

# ── Nostr identity ───────────────────────────────────────────────────────────

# 64-character lowercase hex secp256k1 private key. When set, the node keeps a
# stable Nostr identity across restarts; otherwise a new keypair is generated on
# each startup and prior announcements cannot be updated.
#
# Generate one:
#   python -c "from nostr.key import PrivateKey; print(PrivateKey().raw_secret.hex())"
# NOSTR_PRIVATE_KEY=

# ── Optional: Fedimint ecash ─────────────────────────────────────────────────

# A second payment path alongside Lightning. When configured, 402 responses
# advertise ecash_accepted and endpoints accept ecash_notes.
# FEDIMINT_CLIENTD_URL=http://localhost:3333
# FEDIMINT_CLIENTD_PASSWORD=your_fedimint_password

# ── Optional: identity gate ──────────────────────────────────────────────────

# Require callers of streamfinder.search to present a registered NIP-05 identity
# whose trust score clears the minimum.
# IDENTITY_REQUIRE_FOR_PAID_SERVICES=false
# IDENTITY_MIN_TRUST_SCORE=0.25

# Serve identity.* lookups for free instead of charging for them.
# IDENTITY_FREE_QUERIES=false
